{
  "name": "@sena/frontend-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fachada transversal de autenticación, HTTP, configuración y eventos del frontend SENA.",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "contracts:generate": "openapi-typescript ../design-software-shared-contracts/openapi/iam.yaml -o src/contracts/generated/iam.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "7.6.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}